# AgriMarket Recommendation Feature
# Phase 5: CI/CD Pipeline (Node.js)
# Author: AJEICHEK ABEL NISSI (CT23A010)
#
# Converted from Python to Node.js.
# Docker build & push steps are UNCHANGED.

name: AgriMarket CI/CD

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

env:
  REGISTRY: ghcr.io
  IMAGE_PREFIX: ${{ github.repository_owner }}/agrimarket

jobs:
  # ---------------------------------------------------------------------------
  # Phase 1: Test Tracking API (Node.js)
  # ---------------------------------------------------------------------------
  test-tracker:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: phase1_tracking/api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: phase1_tracking/api/package-lock.json
      - run: npm ci
      - run: npm test
        env:
          NODE_ENV: test

  # ---------------------------------------------------------------------------
  # Phase 3: Test Recommendation API (Node.js)
  # ---------------------------------------------------------------------------
  test-api:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: phase3_api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: phase3_api/package-lock.json
      - run: npm ci
      - run: npm test
        env:
          NODE_ENV: test
          MODELS_DIR: models
          DATA_DIR: data

  # ---------------------------------------------------------------------------
  # Phase 4: Widget tests (unchanged — already JavaScript)
  # ---------------------------------------------------------------------------
  test-widget:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: phase4_widget
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: phase4_widget/package-lock.json
      - run: npm ci
      - run: npm test

  # ---------------------------------------------------------------------------
  # Build & push Docker images (UNCHANGED — same structure)
  # ---------------------------------------------------------------------------
  docker-build:
    needs: [test-tracker, test-api, test-widget]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push agri-tracker
        uses: docker/build-push-action@v5
        with:
          context: phase1_tracking/api
          push: true
          tags: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}-tracker:latest

      - name: Build and push agri-api
        uses: docker/build-push-action@v5
        with:
          context: phase3_api
          push: true
          tags: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}-api:latest

  # ---------------------------------------------------------------------------
  # Deploy to Vercel (phase3_api recommendation API)
  # ---------------------------------------------------------------------------
  deploy-vercel:
    needs: [test-api]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    defaults:
      run:
        working-directory: phase3_api
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - run: npm install -g vercel
      - run: vercel --prod --token=${{ secrets.VERCEL_TOKEN }} --yes
        env:
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
