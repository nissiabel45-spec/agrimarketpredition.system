/**
 * AgriMarket Recommendation Widget — Stylesheet
 * Phase 4 | Author: AJEICHEK ABEL NISSI (CT23A010)
 *
 * All selectors are prefixed with .agri-rec__ to avoid collisions
 * with Agromarket's existing CSS.
 *
 * Palette:
 *   Primary green   #2d6a2d  (matches Agromarket header)
 *   Light green     #e1f5ee
 *   Text primary    #1a1a1a
 *   Text muted      #666666
 *   Border          #e0e0e0
 *   Background      #ffffff
 *   Card bg         #f8f9f8
 */

/* ---- Widget container ------------------------------------------ */

.agri-rec {
  background: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 10px;
  padding: 18px 20px;
  margin: 24px 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
}

/* ---- Header ---------------------------------------------------- */

.agri-rec__header {
  margin-bottom: 14px;
}

.agri-rec__header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
}

.agri-rec__header-left {
  display: flex;
  align-items: center;
  gap: 7px;
}

.agri-rec__icon {
  font-size: 16px;
  line-height: 1;
}

.agri-rec__heading {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  margin: 0;
  line-height: 1.3;
}

.agri-rec__subtitle {
  font-size: 12px;
  color: #888888;
  margin: 3px 0 0;
}

/* ---- Product grid ---------------------------------------------- */

.agri-rec__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px;
  margin-bottom: 12px;
}

/* ---- Product card ---------------------------------------------- */

.agri-rec__card {
  background: #f8f9f8;
  border: 1px solid #e8ebe8;
  border-radius: 8px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  transition: border-color .15s ease, transform .1s ease;
  cursor: pointer;
}

.agri-rec__card:hover {
  border-color: #2d6a2d;
  transform: translateY(-2px);
}

.agri-rec__img {
  height: 70px;
  background: #e1f5ee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agri-rec__emoji {
  font-size: 28px;
  line-height: 1;
  user-select: none;
}

.agri-rec__body {
  padding: 8px 10px 10px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.agri-rec__title {
  font-size: 11.5px;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  margin: 0 0 3px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.agri-rec__category {
  font-size: 10px;
  color: #2d6a2d;
  font-weight: 500;
  text-transform: capitalize;
  margin-bottom: 6px;
  display: block;
}

/* Confidence score bar */
.agri-rec__bar {
  height: 3px;
  background: #e0e8e0;
  border-radius: 2px;
  overflow: hidden;
  margin-top: auto;
}

.agri-rec__bar-fill {
  height: 100%;
  background: #2d6a2d;
  border-radius: 2px;
  transition: width .4s ease;
}

/* ---- Skeleton loader ------------------------------------------- */

@keyframes agri-shimmer {
  0%   { background-position: -400px 0; }
  100% { background-position:  400px 0; }
}

.agri-rec__card--skeleton {
  pointer-events: none;
  cursor: default;
}

.agri-rec__card--skeleton:hover {
  transform: none;
  border-color: #e8ebe8;
}

.agri-rec__img--skeleton {
  background: linear-gradient(90deg, #eeeeee 25%, #f5f5f5 50%, #eeeeee 75%);
  background-size: 400px 100%;
  animation: agri-shimmer 1.4s infinite;
}

.agri-rec__skeleton-line {
  border-radius: 4px;
  background: linear-gradient(90deg, #eeeeee 25%, #f5f5f5 50%, #eeeeee 75%);
  background-size: 400px 100%;
  animation: agri-shimmer 1.4s infinite;
  margin-bottom: 6px;
}

.agri-rec__skeleton-line--title {
  height: 11px;
  width: 85%;
}

.agri-rec__skeleton-line--cat {
  height: 9px;
  width: 55%;
}

/* ---- Footer ---------------------------------------------------- */

.agri-rec__footer {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-top: 10px;
  border-top: 1px solid #f0f0f0;
}

.agri-rec__reason {
  font-size: 11px;
  color: #999999;
  margin: 0;
  flex: 1;
  line-height: 1.4;
}

/* ---- Buttons --------------------------------------------------- */

.agri-rec__btn {
  font-family: inherit;
  font-size: 11.5px;
  padding: 5px 11px;
  border-radius: 6px;
  cursor: pointer;
  white-space: nowrap;
  transition: background .12s ease;
  line-height: 1;
}

.agri-rec__btn--ghost {
  background: #ffffff;
  border: 1px solid #d0d8d0;
  color: #2d6a2d;
  font-weight: 500;
}

.agri-rec__btn--ghost:hover {
  background: #e1f5ee;
  border-color: #2d6a2d;
}

.agri-rec__btn--muted {
  background: none;
  border: none;
  color: #aaaaaa;
  padding: 5px 6px;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.agri-rec__btn--muted:hover {
  color: #555555;
}

/* ---- Responsive ----------------------------------------------- */

@media (max-width: 600px) {
  .agri-rec {
    padding: 14px 14px;
    margin: 16px 0;
  }

  .agri-rec__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .agri-rec__footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
}

@media (max-width: 360px) {
  .agri-rec__grid {
    grid-template-columns: 1fr;
  }
}
